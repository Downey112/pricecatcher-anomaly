            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Reading the trend",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The budget is fixed at 20 prices per district each week, so the weekly total barely moves. What changes is why prices stand out.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "About half the flags each week are shops that are always pricier than their peers (persistent premium). They are worth a look once, then they mostly use up budget.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Infant formula and some packaged goods top the flag rate: same item code, very different prices across shop types.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Hints are rules of thumb, not verified causes.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#64748B"
                    }
                  }
                ]
              }
            ]
          }
        }
