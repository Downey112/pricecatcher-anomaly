	partition paired = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\paired.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"comparison", type text},
				        {"planted", type text},
				        {"planted_order", Int64.Type},
				        {"diff", type number},
				        {"ci_lo", type number},
				        {"ci_hi", type number},
				        {"verdict", type text}
				    }, "en-US")
				in
				    Typed
