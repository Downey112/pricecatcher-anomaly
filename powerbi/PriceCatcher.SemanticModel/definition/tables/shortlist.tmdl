	partition shortlist = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\shortlist.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"state", type text},
				        {"district", type text},
				        {"district_key", type text},
				        {"premise", type text},
				        {"premise_type", type text},
				        {"item_category", type text},
				        {"item", type text},
				        {"unit", type text},
				        {"price", type number},
				        {"ref_price", type number},
				        {"ratio_to_ref", type number},
				        {"peer_count", Int64.Type},
				        {"own_premium", type number},
				        {"score", type number},
				        {"rank_in_district", Int64.Type},
				        {"likely_cause", type text},
				        {"cause_order", Int64.Type}
				    }, "en-US")
				in
				    Typed
