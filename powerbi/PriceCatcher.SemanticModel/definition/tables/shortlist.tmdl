table shortlist
	lineageTag: 07904230-2112-50c9-8cdf-9b3aa6186b81

	measure 'Flagged Prices' = COUNTROWS ( shortlist )
		formatString: #,0
		displayFolder: KPI
		lineageTag: 7da46f17-2e24-5c3d-a1bc-4443130e7557

	measure 'Districts Covered' = DISTINCTCOUNT ( shortlist[district_key] )
		formatString: #,0
		displayFolder: KPI
		lineageTag: bbb4f9ea-6f33-5619-9bda-27e966eb73b7

	measure 'Median Ratio' = MEDIAN ( shortlist[ratio_to_ref] )
		formatString: 0.00"×"
		displayFolder: KPI
		lineageTag: ba30954d-f259-56d9-8533-12b7cc1989da

	measure 'Persistent Share' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( shortlist ), KEEPFILTERS ( shortlist[likely_cause] = "persistent premium" ) ),
			    COUNTROWS ( shortlist )
			)
		formatString: 0%
		displayFolder: KPI
		lineageTag: 8ba2ad25-43f5-5479-8e6d-53e4321dca3b

	measure 'Data Quality Flags' =
			CALCULATE (
			    COUNTROWS ( shortlist ),
			    KEEPFILTERS ( shortlist[likely_cause] IN { "first observation", "pack/unit mismatch?", "decimal slip?" } )
			) + 0
		formatString: #,0
		displayFolder: KPI
		lineageTag: 5d7f92bd-a2c6-5521-b6d0-6412eae927f1

	measure 'Label Flagged' = "top 20 per district · " & FORMAT ( [Districts Covered], "#,0" ) & " districts"
		displayFolder: Labels
		lineageTag: 184f406d-4c37-5393-93a1-32c53027130a

	measure 'Label Districts' = "with at least 5 comparable shops"
		displayFolder: Labels
		lineageTag: 143aae27-2468-5cbe-a3a4-c7dfc5f7a64c

	measure 'Label Median' = "flagged price ÷ peer median"
		displayFolder: Labels
		lineageTag: 969f638e-08c3-5be5-8fb4-5d075a3415b0

	measure 'Label Persistent' = "shops usually 15%+ above peers"
		displayFolder: Labels
		lineageTag: d71426f5-f665-56a0-8435-cc62fd35c6b3

	measure 'Label Quality' = "first price, pack size or decimal slip?"
		displayFolder: Labels
		lineageTag: 1fdd9e87-172c-55d5-82f5-5a067cba3fab

	measure 'Title Shortlist' = "Inspection shortlist · week of " & FORMAT ( MAX ( run_info[latest_week] ), "d mmm yyyy" ) & " · highest score first"
		displayFolder: Titles
		lineageTag: 0e74fb30-abd2-59c9-a10a-0294cbaf746b

