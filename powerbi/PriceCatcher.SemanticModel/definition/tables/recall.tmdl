table recall
	lineageTag: 32dc3c35-d8a1-5178-a136-4b5c77339b5a

	measure 'Recall MAD' = CALCULATE ( AVERAGE ( recall[recall] ), recall[split] = "test", recall[scorer_label] = "MAD baseline" )
		formatString: 0%
		displayFolder: Recall
		lineageTag: 9822fa99-675f-544b-823a-ab187859de89

	measure 'Recall IForest' = CALCULATE ( AVERAGE ( recall[recall] ), recall[split] = "test", recall[scorer_label] = "Isolation Forest" )
		formatString: 0%
		displayFolder: Recall
		lineageTag: 8ed31388-50a1-5971-b2a6-105241ccb950

	measure 'Recall ECOD' = CALCULATE ( AVERAGE ( recall[recall] ), recall[split] = "test", recall[scorer_label] = "ECOD" )
		formatString: 0%
		displayFolder: Recall
		lineageTag: cef6f558-29db-5b82-8ce3-132f366fa43b

