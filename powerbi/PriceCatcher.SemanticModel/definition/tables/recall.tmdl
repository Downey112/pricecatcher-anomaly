	partition recall = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\recall.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"split", type text},
				        {"scorer_label", type text},
				        {"scorer_order", Int64.Type},
				        {"planted", type text},
				        {"planted_order", Int64.Type},
				        {"recall", type number},
				        {"precision_at_k", type number},
				        {"average_precision", type number}
				    }, "en-US")
				in
				    Typed
